{
 "name": "OPTIC — Offline Player & Transcoder for Images & Clips",
 "short_name": "OPTIC",
 "description": "Play and convert images, audio and video entirely on your device.",
 "start_url": "./",
 "scope": "./",
 "display": "standalone",
 "background_color": "#121211",
 "theme_color": "#17171a",
 "icons": [
  {
   "src": "icon-192.png",
   "sizes": "192x192",
   "type": "image/png",
   "purpose": "any maskable"
  },
  {
   "src": "icon-512.png",
   "sizes": "512x512",
   "type": "image/png",
   "purpose": "any maskable"
  }
 ],
 "file_handlers": [
  {
   "action": "./",
   "accept": {
    "image/*": [
     ".png",
     ".jpg",
     ".jpeg",
     ".webp",
     ".avif",
     ".gif",
     ".bmp",
     ".ico",
     ".tif",
     ".tiff",
     ".svg"
    ],
    "audio/*": [
     ".mp3",
     ".wav",
     ".ogg",
     ".oga",
     ".opus",
     ".m4a",
     ".flac",
     ".aac",
     ".weba"
    ],
    "video/*": [
     ".mp4",
     ".m4v",
     ".webm",
     ".mov",
     ".mkv",
     ".ogv",
     ".ts",
     ".mts",
     ".m2ts"
    ]
   }
  }
 ]
}
